# Public discovery only. This does not authorize account actions.
YOUTUBE_API_KEY=

# Absolute path to a Google OAuth desktop-client JSON file. Needed only for account and creator tools.
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=

# Stable local profile name used to isolate OAuth, operation, upload, and curation state.
# Required for Phase 2 creator tools. Example: creator-main
YOUTUBE_MCP_PROFILE_ID=

# Immutable UC... channel ID that the selected creator OAuth principal must match.
# Required for Phase 2 creator reads and writes.
YOUTUBE_MCP_CHANNEL_ID=

# Optional; defaults to ~/.youtube-mcp. Holds local refresh-token, operation, upload, and Takeout state.
YOUTUBE_MCP_STATE_DIR=

# The default smoke command is offline. Set to 1 only for a developer-owned API key to make one read-only API call.
YOUTUBE_LIVE_SMOKE=0
