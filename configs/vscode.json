{
  "inputs": [
    {
      "type": "promptString",
      "id": "youtube-api-key",
      "description": "YouTube Data API v3 key",
      "password": true
    }
  ],
  "servers": {
    "youtube-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "https://github.com/pratikgh0se/youtube-mcp/releases/download/v0.3.0/youtube-mcp-0.3.0.tgz",
        "--transport",
        "stdio"
      ],
      "env": {
        "YOUTUBE_API_KEY": "${input:youtube-api-key}"
      }
    }
  }
}
