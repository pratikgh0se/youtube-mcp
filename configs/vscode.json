{
  "inputs": [
    {
      "type": "promptString",
      "id": "youtube-api-key",
      "description": "YouTube Data API v3 key",
      "password": true
    }
  ],
  "servers": {
    "youtube-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "github:pratikgh0se/youtube-mcp#v0.2.0",
        "--transport",
        "stdio"
      ],
      "env": {
        "YOUTUBE_API_KEY": "${input:youtube-api-key}"
      }
    }
  }
}
