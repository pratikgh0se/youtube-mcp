{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "youtube-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "github:pratikgh0se/youtube-mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "environment": {
        "YOUTUBE_API_KEY": "{env:YOUTUBE_API_KEY}",
        "YOUTUBE_OAUTH_CLIENT_SECRET_FILE": "{env:YOUTUBE_OAUTH_CLIENT_SECRET_FILE}",
        "YOUTUBE_MCP_PROFILE_ID": "{env:YOUTUBE_MCP_PROFILE_ID}",
        "YOUTUBE_MCP_CHANNEL_ID": "{env:YOUTUBE_MCP_CHANNEL_ID}"
      }
    }
  }
}
