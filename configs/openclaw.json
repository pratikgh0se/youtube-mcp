{
  "mcp": {
    "servers": {
      "youtube-mcp": {
        "command": "npx",
        "args": [
          "-y",
          "github:pratikgh0se/youtube-mcp#v0.2.0",
          "--transport",
          "stdio"
        ],
        "env": {
          "YOUTUBE_API_KEY": "${YOUTUBE_API_KEY}",
          "YOUTUBE_MCP_CHANNEL_ID": "${YOUTUBE_MCP_CHANNEL_ID}",
          "YOUTUBE_MCP_PROFILE_ID": "${YOUTUBE_MCP_PROFILE_ID}",
          "YOUTUBE_OAUTH_CLIENT_SECRET_FILE": "${YOUTUBE_OAUTH_CLIENT_SECRET_FILE}",
          "YOUTUBE_MCP_STATE_DIR": "${YOUTUBE_MCP_STATE_DIR}"
        }
      }
    }
  }
}
