{
  "mcpServers": {
    "youtube-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "https://github.com/pratikgh0se/youtube-mcp/releases/download/v0.3.1/youtube-mcp-0.3.1.tgz",
        "--transport",
        "stdio"
      ],
      "env": {
        "YOUTUBE_API_KEY": "<your-youtube-api-key>"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
