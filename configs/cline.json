{
  "mcpServers": {
    "youtube-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "github:pratikgh0se/youtube-mcp",
        "--transport",
        "stdio"
      ],
      "env": {
        "YOUTUBE_API_KEY": "<your-youtube-api-key>"
      },
      "disabled": false,
      "autoApprove": []
    }
  }
}
